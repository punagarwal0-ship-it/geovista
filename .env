# Geospatial Intelligence Frontend Configuration
# Live Backend API URL (leave empty to use the built-in DEMO/SYNTHETIC API adapter)
VITE_API_BASE_URL=

# Mode flag: Force mock/demo fixtures when true or when backend is unreachable
VITE_ENABLE_MOCK_DATA=true

# Default Map Center (Longitude, Latitude) - Centered near Bay of Bengal / India subcontinent
VITE_MAP_DEFAULT_LON=85.0
VITE_MAP_DEFAULT_LAT=20.5
VITE_MAP_DEFAULT_ZOOM=5

# Maximum allowed AOI size in square kilometers (safety validation)
VITE_MAX_AOI_SQKM=100000

